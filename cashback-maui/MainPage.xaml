<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:cashback_maui.Views"
    x:Class="cashback_maui.MainPage">

    <Grid RowDefinitions="*,54">

        <!-- Основное содержимое -->
        <ContentView
            x:Name="ContentHost"
            Grid.Row="0" />

        <!-- Нижняя навигация -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*,*"
            BackgroundColor="{StaticResource AppBackground}">

            <ImageButton
                Grid.Column="0"
                Source="cashback_cards_dark.svg"
                BackgroundColor="Transparent"
                Padding="0"
                WidthRequest="12.36"
                HeightRequest="12.36"
                Aspect="AspectFit" />

            <ImageButton
                Grid.Column="1"
                Source="discount_cards_dark.svg"
                BackgroundColor="Transparent"
                Padding="0"
                WidthRequest="17"
                HeightRequest="16.23"
                Aspect="AspectFit" />

            <ImageButton
                Grid.Column="2"
                Source="menu_dark.svg"
                BackgroundColor="Transparent"
                Padding="0"
                WidthRequest="13.91"
                HeightRequest="9.27"
                Aspect="AspectFit" />

        </Grid>

    </Grid>

</ContentPage>
