<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="cashback_maui.MainPage">

    <Grid RowDefinitions="*,54">

        <!-- Контейнер представлений -->
        <ContentView
            x:Name="ContentHost"
            Grid.Row="0" />

        <!-- Нижняя навигация -->
        <Grid
            x:Name="BottomNavigation"
            Grid.Row="1"
            ColumnDefinitions="*,*,*">

            <!-- Кэшбэк/банковские карты -->
            <Grid Grid.Column="0">

                <Ellipse
                    x:Name="CashbackIndicator"
                    WidthRequest="42"
                    HeightRequest="42"
                    Fill="#252525"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    IsVisible="False" />

                <Image
                    x:Name="CashbackIcon"
                    Source="cashback_cards_dark.svg"
                    WidthRequest="12.36"
                    HeightRequest="12.36"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

                <Button
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Padding="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Clicked="OnCashbacksClicked" />

            </Grid>

            <!-- Дисконтные карты -->
            <Grid Grid.Column="1">

                <Ellipse
                    x:Name="DiscountIndicator"
                    WidthRequest="42"
                    HeightRequest="42"
                    Fill="#252525"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    IsVisible="False" />

                <Image
                    x:Name="DiscountIcon"
                    Source="discount_cards_dark.svg"
                    WidthRequest="17"
                    HeightRequest="16.23"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

                <Button
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Padding="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Clicked="OnDiscountsClicked" />

            </Grid>

            <!-- Меню -->
            <Grid Grid.Column="2">

                <Ellipse
                    x:Name="MenuIndicator"
                    WidthRequest="42"
                    HeightRequest="42"
                    Fill="#252525"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    IsVisible="False" />

                <Image
                    x:Name="MenuIcon"
                    Source="menu_dark.svg"
                    WidthRequest="13.91"
                    HeightRequest="9.27"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

                <Button
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Padding="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Clicked="OnMenuClicked" />

            </Grid>

        </Grid>

    </Grid>

</ContentPage>