<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="cashback_maui.Views.CashbacksView">

    <VerticalStackLayout
        Padding="20"
        Spacing="20"
        VerticalOptions="Center">

        <Label
            Text="Cashback App"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Button
            Text="Добавить карту"
            BackgroundColor="#F5D547"
            TextColor="Black"
            CornerRadius="12" />

    </VerticalStackLayout>

</ContentView>
